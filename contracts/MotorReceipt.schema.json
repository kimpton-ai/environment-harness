{
  "$defs": {
    "ControlClaim": {
      "additionalProperties": false,
      "description": "A channel and its resources, owned by a direct or adapter-backed controller.",
      "properties": {
        "channel": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "controls": {
          "minProperties": 1,
          "title": "Controls",
          "type": "object"
        },
        "owner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_namespace": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner Namespace",
          "type": "string"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceOwnership"
          },
          "title": "Resources",
          "type": "array"
        }
      },
      "required": [
        "channel",
        "owner",
        "owner_namespace",
        "controls"
      ],
      "title": "ControlClaim",
      "type": "object"
    },
    "GoalContext": {
      "additionalProperties": false,
      "description": "Versioned, immutable authority context shared by coordinated controls.",
      "properties": {
        "goal_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Goal Id",
          "type": "string"
        },
        "milestone_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Milestone Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "revision",
        "milestone_id"
      ],
      "title": "GoalContext",
      "type": "object"
    },
    "MotorControlPermission": {
      "additionalProperties": false,
      "description": "One exact, environment-issued permission for bounded control inputs.",
      "properties": {
        "controls": {
          "title": "Controls",
          "type": "object"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "max_steps": {
          "default": 1,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_travel": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Travel"
        },
        "protected_region_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protected Region Revision"
        }
      },
      "required": [
        "id"
      ],
      "title": "MotorControlPermission",
      "type": "object"
    },
    "MotorGroup": {
      "additionalProperties": false,
      "description": "Bounded coordinated control contract; execution is owned by the runtime.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ControlClaim"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "deadline_ms": {
          "default": 10000,
          "maximum": 120000,
          "minimum": 1,
          "title": "Deadline Ms",
          "type": "integer"
        },
        "goal_context": {
          "$ref": "#/$defs/GoalContext"
        },
        "group_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "max_ticks": {
          "default": 32,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Ticks",
          "type": "integer"
        },
        "stop_epoch": {
          "default": 0,
          "minimum": 0,
          "title": "Stop Epoch",
          "type": "integer"
        }
      },
      "required": [
        "group_id",
        "goal_context",
        "claims"
      ],
      "title": "MotorGroup",
      "type": "object"
    },
    "MotorProfile": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "executor": {
          "const": "motor.v1",
          "default": "motor.v1",
          "enum": [
            "motor.v1"
          ],
          "title": "Executor",
          "type": "string"
        },
        "mode": {
          "default": "deterministic",
          "enum": [
            "deterministic",
            "jev"
          ],
          "title": "Mode",
          "type": "string"
        },
        "selector_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selector Model"
        }
      },
      "required": [
        "adapter"
      ],
      "title": "MotorProfile",
      "type": "object"
    },
    "MotorRequest": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "title": "Arguments",
          "type": "object"
        },
        "control_permissions": {
          "items": {
            "$ref": "#/$defs/MotorControlPermission"
          },
          "maxItems": 128,
          "title": "Control Permissions",
          "type": "array"
        },
        "expected": {
          "minProperties": 1,
          "title": "Expected",
          "type": "object"
        },
        "goal_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "goal_revision": {
          "minLength": 1,
          "title": "Goal Revision",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/MotorGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_recovery_attempts": {
          "default": 0,
          "maximum": 128,
          "minimum": 0,
          "title": "Max Recovery Attempts",
          "type": "integer"
        },
        "max_steps": {
          "default": 32,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "observation_revision": {
          "minLength": 1,
          "title": "Observation Revision",
          "type": "string"
        },
        "skill": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Skill",
          "type": "string"
        },
        "stop_epoch": {
          "default": 0,
          "minimum": 0,
          "title": "Stop Epoch",
          "type": "integer"
        },
        "target": {
          "title": "Target",
          "type": "object"
        },
        "timeout_ms": {
          "default": 10000,
          "maximum": 120000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "skill",
        "target",
        "expected",
        "observation_revision",
        "goal_revision"
      ],
      "title": "MotorRequest",
      "type": "object"
    },
    "MotorSelection": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "cost_micros": {
          "default": 0,
          "minimum": 0,
          "title": "Cost Micros",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "usage": {
          "title": "Usage",
          "type": "object"
        }
      },
      "required": [
        "model"
      ],
      "title": "MotorSelection",
      "type": "object"
    },
    "ResourceOwnership": {
      "additionalProperties": false,
      "description": "A resource lease claimed by one named channel owner.",
      "properties": {
        "namespace": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "resource": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "resource",
        "owner",
        "namespace"
      ],
      "title": "ResourceOwnership",
      "type": "object"
    }
  },
  "$id": "urn:environment-harness:v1:MotorReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "title": "After",
      "type": "object"
    },
    "before": {
      "title": "Before",
      "type": "object"
    },
    "cost_micros": {
      "default": 0,
      "minimum": 0,
      "title": "Cost Micros",
      "type": "integer"
    },
    "effect": {
      "default": "none",
      "enum": [
        "none",
        "possible",
        "applied"
      ],
      "title": "Effect",
      "type": "string"
    },
    "elapsed_ms": {
      "minimum": 0.0,
      "title": "Elapsed Ms",
      "type": "number"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "outcome": {
      "default": "completed",
      "enum": [
        "rejected",
        "accepted",
        "started",
        "completed",
        "cancelled",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/MotorProfile"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "reason_code": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "request": {
      "$ref": "#/$defs/MotorRequest"
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/MotorSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "default": [],
      "items": {
        "type": "object"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "operation_id",
    "status",
    "profile",
    "request",
    "elapsed_ms"
  ],
  "title": "MotorReceipt",
  "type": "object"
}
