{
  "$defs": {
    "MotorExecutionMetadata": {
      "additionalProperties": false,
      "description": "The fencing values that make a motor operation admissible.",
      "properties": {
        "contract_version": {
          "const": "motor.execution.v1",
          "default": "motor.execution.v1",
          "title": "Contract Version",
          "type": "string"
        },
        "epoch": {
          "default": 0,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "goal_revision": {
          "minLength": 1,
          "title": "Goal Revision",
          "type": "string"
        },
        "interface_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Revision"
        },
        "observation_revision": {
          "minLength": 1,
          "title": "Observation Revision",
          "type": "string"
        },
        "owner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "stop_epoch": {
          "default": 0,
          "minimum": 0,
          "title": "Stop Epoch",
          "type": "integer"
        },
        "ui_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ui Revision"
        }
      },
      "required": [
        "owner",
        "goal_revision",
        "observation_revision"
      ],
      "title": "MotorExecutionMetadata",
      "type": "object"
    },
    "MotorStep": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "controls": {
          "additionalProperties": true,
          "title": "Controls",
          "type": "object"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "additionalProperties": true,
          "title": "Target",
          "type": "object"
        }
      },
      "required": [
        "operation",
        "target"
      ],
      "title": "MotorStep",
      "type": "object"
    }
  },
  "$id": "urn:environment-harness:v1:PreparedSuccessorIntent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A successor that may be admitted at a native boundary.\n\nPreparation records intent only. It never proves that the successor ran.",
  "properties": {
    "contract_version": {
      "const": "motor.prepared-successor.v1",
      "default": "motor.prepared-successor.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "freshness_ms": {
      "default": 1000,
      "maximum": 120000,
      "minimum": 1,
      "title": "Freshness Ms",
      "type": "integer"
    },
    "intent_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Intent Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/MotorExecutionMetadata"
    },
    "operation_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "phase": {
      "const": "prepared",
      "default": "prepared",
      "title": "Phase",
      "type": "string"
    },
    "predecessor_operation_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Predecessor Operation Id",
      "type": "string"
    },
    "prepared_at_ms": {
      "minimum": 0,
      "title": "Prepared At Ms",
      "type": "number"
    },
    "step": {
      "$ref": "#/$defs/MotorStep"
    }
  },
  "required": [
    "intent_id",
    "operation_id",
    "predecessor_operation_id",
    "metadata",
    "step",
    "prepared_at_ms"
  ],
  "title": "PreparedSuccessorIntent",
  "type": "object"
}
