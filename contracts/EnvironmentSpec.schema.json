{
  "$defs": {
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "agent_checkpoint": {
          "default": false,
          "title": "Agent Checkpoint",
          "type": "boolean"
        },
        "branch": {
          "default": false,
          "title": "Branch",
          "type": "boolean"
        },
        "checkpoint": {
          "default": false,
          "title": "Checkpoint",
          "type": "boolean"
        },
        "external_writes": {
          "default": false,
          "title": "External Writes",
          "type": "boolean"
        },
        "live_reads": {
          "default": false,
          "title": "Live Reads",
          "type": "boolean"
        },
        "logprobs": {
          "default": false,
          "title": "Logprobs",
          "type": "boolean"
        },
        "rendered_requests": {
          "default": false,
          "title": "Rendered Requests",
          "type": "boolean"
        },
        "replay": {
          "default": true,
          "title": "Replay",
          "type": "boolean"
        },
        "resume": {
          "default": false,
          "title": "Resume",
          "type": "boolean"
        },
        "token_ids": {
          "default": false,
          "title": "Token Ids",
          "type": "boolean"
        }
      },
      "title": "Capabilities",
      "type": "object"
    }
  },
  "$id": "urn:environment-harness:v1:EnvironmentSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_schema": {
      "additionalProperties": true,
      "title": "Action Schema",
      "type": "object"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "implementation": {
      "minLength": 1,
      "title": "Implementation",
      "type": "string"
    },
    "missing_action": {
      "default": "reject",
      "enum": [
        "reject",
        "noop"
      ],
      "title": "Missing Action",
      "type": "string"
    },
    "modalities": {
      "default": [
        "text",
        "json"
      ],
      "items": {
        "type": "string"
      },
      "title": "Modalities",
      "type": "array"
    },
    "motor_skills": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Motor Skills",
      "type": "array"
    },
    "observation_schema": {
      "additionalProperties": true,
      "title": "Observation Schema",
      "type": "object"
    },
    "phase_deadline": {
      "default": "wall",
      "enum": [
        "wall",
        "coordinator"
      ],
      "title": "Phase Deadline",
      "type": "string"
    },
    "phase_seconds": {
      "default": 60,
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Phase Seconds",
      "type": "number"
    },
    "protocol": {
      "const": "environment-session.v1",
      "default": "environment-session.v1",
      "title": "Protocol",
      "type": "string"
    },
    "purposes": {
      "default": [
        "evaluation"
      ],
      "items": {
        "enum": [
          "evaluation",
          "training"
        ],
        "type": "string"
      },
      "title": "Purposes",
      "type": "array"
    },
    "scheduling": {
      "enum": [
        "sequential",
        "simultaneous",
        "event"
      ],
      "title": "Scheduling",
      "type": "string"
    },
    "stale_action": {
      "const": "reject",
      "default": "reject",
      "title": "Stale Action",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "implementation",
    "scheduling"
  ],
  "title": "EnvironmentSpec",
  "type": "object"
}
