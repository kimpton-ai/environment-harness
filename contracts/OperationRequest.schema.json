{
  "$id": "urn:environment-harness:v2:OperationRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One host-authorized external operation requested by a v2 transition.",
  "properties": {
    "depends_on": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Depends On",
      "type": "array"
    },
    "key": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Key",
      "type": "string"
    },
    "max_cost_micros": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Max Cost Micros",
      "type": "integer"
    },
    "operation": {
      "pattern": "^[a-zA-Z0-9_.-]{1,160}$",
      "title": "Operation",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "key",
    "operation",
    "version"
  ],
  "title": "OperationRequest",
  "type": "object"
}
