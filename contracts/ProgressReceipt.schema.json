{
  "$id": "urn:environment-harness:v1:ProgressReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable progress for one coordinated group tick.",
  "properties": {
    "channel": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Channel",
      "type": "string"
    },
    "group_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Group Id",
      "type": "string"
    },
    "operation_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "stop_epoch": {
      "minimum": 0,
      "title": "Stop Epoch",
      "type": "integer"
    },
    "tick": {
      "minimum": 0,
      "title": "Tick",
      "type": "integer"
    }
  },
  "required": [
    "group_id",
    "tick",
    "channel",
    "status",
    "operation_id",
    "stop_epoch"
  ],
  "title": "ProgressReceipt",
  "type": "object"
}
