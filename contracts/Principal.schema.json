{
  "$id": "urn:environment-harness:v1:Principal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    },
    "generation": {
      "default": 0,
      "title": "Generation",
      "type": "integer"
    },
    "participant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Participant"
    },
    "role": {
      "enum": [
        "researcher",
        "agent",
        "scorer",
        "worker"
      ],
      "title": "Role",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "tenant": {
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "tenant",
    "subject",
    "role"
  ],
  "title": "Principal",
  "type": "object"
}
