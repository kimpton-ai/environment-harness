{
  "$id": "urn:environment-harness:v1:MotorSelection",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "cost_micros": {
      "default": 0,
      "minimum": 0,
      "title": "Cost Micros",
      "type": "integer"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "probabilities": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Probabilities",
      "type": "object"
    },
    "usage": {
      "title": "Usage",
      "type": "object"
    }
  },
  "required": [
    "model"
  ],
  "title": "MotorSelection",
  "type": "object"
}
