{
  "$defs": {
    "NativeTimeCoordinate": {
      "additionalProperties": true,
      "properties": {
        "clock": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Clock",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "clock",
        "value"
      ],
      "title": "NativeTimeCoordinate",
      "type": "object"
    },
    "RecordTime": {
      "additionalProperties": true,
      "description": "Clocks are preserved, never coerced into one scalar.\n\nOrdering comes from the durable record sequence and causal links; a\ntimestamp alone never establishes causality.",
      "properties": {
        "monotonicOffsetNs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monotonicoffsetns"
        },
        "monotonicOrigin": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monotonicorigin"
        },
        "native": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NativeTimeCoordinate"
          },
          "title": "Native",
          "type": "array"
        },
        "wallTime": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walltime"
        }
      },
      "title": "RecordTime",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "type": "string"
          },
          "title": "Audience",
          "type": "array"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "participant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Participant"
        },
        "position": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Position",
          "type": "string"
        },
        "previous_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Previous Hash",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "segment": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Segment",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/RecordTime"
        },
        "type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "position",
        "previous_hash",
        "source_hash",
        "type",
        "segment",
        "participant",
        "revision",
        "time",
        "data",
        "audience"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "$id": "urn:environment-harness:v1:SourceIngestionBatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "records"
  ],
  "title": "SourceIngestionBatch",
  "type": "object"
}
