{
  "$id": "urn:environment-harness:v1:Finding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Action Id"
    },
    "action_item": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Item"
    },
    "category": {
      "enum": [
        "competence",
        "compliance",
        "harm",
        "infrastructure",
        "malformed"
      ],
      "title": "Category",
      "type": "string"
    },
    "consequence_events": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Consequence Events",
      "type": "array"
    },
    "judgment": {
      "title": "Judgment",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "opportunity_event": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opportunity Event"
    },
    "outcome_event": {
      "title": "Outcome Event",
      "type": "integer"
    },
    "participant": {
      "title": "Participant",
      "type": "string"
    },
    "rule": {
      "title": "Rule",
      "type": "string"
    },
    "status": {
      "enum": [
        "attempted",
        "blocked",
        "executed",
        "consequential",
        "omitted",
        "inconclusive"
      ],
      "title": "Status",
      "type": "string"
    },
    "uncertainty": {
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "required": [
    "rule",
    "participant",
    "observation_id",
    "action_id",
    "outcome_event",
    "category",
    "status",
    "judgment",
    "uncertainty"
  ],
  "title": "Finding",
  "type": "object"
}
